# ==========================================
# CONFIGURAÇÕES DO SERVIDOR
# ==========================================
NODE_ENV=development
PORT=3000


# ==========================================
# SEGURANÇA E AUTENTICAÇÃO
# ==========================================
# Dica: Podes gerar uma chave segura executando no terminal: openssl rand -hex 32
JWT_SECRET=sua_chave_jwt_super_segura_aqui


# ==========================================
# BANCO DE DADOS (POSTGRESQL / DOCKER)
# ==========================================
# Use 'db' para Docker Compose ou 'localhost' para ambiente local sem Docker:
DB_HOST=db
DB_USER=techstore_user
DB_PASSWORD=sua_senha_aqui
DB_NAME=techstore_v2
DB_PORT=5432

# STRING DE CONEXÃO DO PRISMA (valor literal — o dotenv não expande ${VAR})
DATABASE_URL=postgresql://techstore_user:sua_senha_aqui@db:5432/techstore_v2