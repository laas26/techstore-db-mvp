# ==========================================
# CONFIGURAÇÕES DO SERVIDOR
# ==========================================
#
# Para uso com o Docker Compose, estas variáveis devem ficar no .env da RAIZ
# do repositório, e não neste arquivo. O compose lê a raiz, e funciona sem
# nenhum .env porque tem padrão embutido. Este arquivo serve para rodar o
# backend fora do Docker, com a DATABASE_URL apontando para localhost.
#
NODE_ENV=development
PORT=3000
TRUST_PROXY=false
LOGIN_RATE_LIMIT=5
FRONTEND_URL=http://localhost:3001
FRONTEND_ORIGINS=http://localhost,http://localhost:3001,http://localhost:5173
SEED_ON_START=true
SEED_ADMIN_PASSWORD=
SEED_CLIENTE_PASSWORD=


# ==========================================
# SEGURANÇA E AUTENTICAÇÃO
# ==========================================
# Dica: Podes gerar uma chave segura executando no terminal: openssl rand -hex 32
JWT_SECRET=sua_chave_jwt_super_segura_aqui


# ==========================================
# BANCO DE DADOS (POSTGRESQL / DOCKER)
# ==========================================
# Use 'db' para Docker Compose ou 'localhost' para ambiente local sem Docker:
DB_HOST=db
DB_USER=techstore_user
DB_PASSWORD=sua_senha_aqui
DB_NAME=techstore_v2
DB_PORT=5432

# STRING DE CONEXÃO DO PRISMA (valor literal — o dotenv não expande ${VAR})
DATABASE_URL=postgresql://techstore_user:sua_senha_aqui@db:5432/techstore_v2