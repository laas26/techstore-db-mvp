datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id                   Int       @id @default(autoincrement())
  nome                 String
  email                String    @unique
  senhaHash            String
  role                 String    @default("user")
  tokenRedefinicaoHash String?
  tokenRedefinicaoExpiraEm BigInt?
  created_at           DateTime  @default(now())
  carrinhos            Carrinho[]
  pedidos              Pedido[]

  @@map("usuarios")
}

model Produto {
  id         Int       @id @default(autoincrement())
  nome       String
  descricao  String?   @db.Text
  preco      Decimal   @db.Decimal(10, 2)
  stock      Int       @default(0)
  categoria  String?
  imagem     String?
  created_at DateTime  @default(now())
  carrinhos  Carrinho[]
  itens      PedidoItem[]

  @@map("produtos")
}

model Carrinho {
  id         Int     @id @default(autoincrement())
  usuario_id Int
  produto_id Int
  quantidade Int     @default(1)
  usuario    Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  produto    Produto @relation(fields: [produto_id], references: [id], onDelete: Cascade)

  @@map("carrinhos")
}

model Pedido {
  id         Int          @id @default(autoincrement())
  usuario_id Int
  total      Decimal      @db.Decimal(10, 2)
  status     String       @default("pendente")
  created_at DateTime     @default(now())
  usuario    Usuario      @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  itens      PedidoItem[]

  @@map("pedidos")
}

model PedidoItem {
  id             Int     @id @default(autoincrement())
  pedido_id      Int
  produto_id     Int
  quantidade     Int
  preco_unitario Decimal @db.Decimal(10, 2)
  pedido         Pedido  @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  produto        Produto @relation(fields: [produto_id], references: [id], onDelete: Cascade)

  @@map("pedido_itens")
}

model SessaoRevogada {
  id         Int      @id @default(autoincrement())
  token      String   @db.Text
  revoked_at DateTime @default(now())

  @@map("sessoes_revogadas")
}
