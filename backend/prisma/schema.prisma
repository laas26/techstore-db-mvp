datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id                   Int       @id @default(autoincrement())
  nome                 String
  email                String    @unique
  senhaHash            String
  role                 String    @default("user")
  tokenRedefinicaoHash String?
  tokenRedefinicaoExpiraEm BigInt?
  created_at           DateTime  @default(now())
  carrinhos            Carrinho[]
  pedidos              Pedido[]

  @@map("usuarios")
}

model Produto {
  id         Int       @id @default(autoincrement())
  nome       String
  descricao  String?   @db.Text
  preco      Decimal   @db.Decimal(10, 2)
  stock      Int       @default(0)
  categoria  String?
  imagem     String?
  created_at DateTime  @default(now())
  carrinhos  Carrinho[]
  itens      PedidoItem[]

  @@map("produtos")
}

model Carrinho {
  id         Int     @id @default(autoincrement())
  usuario_id Int
  produto_id Int
  quantidade Int     @default(1)
  usuario    Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  produto    Produto @relation(fields: [produto_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, produto_id], map: "carrinhos_usuario_id_produto_id_key")
  @@map("carrinhos")
}

model Pedido {
  id              Int          @id @default(autoincrement())
  usuario_id      Int
  total           Decimal      @db.Decimal(10, 2)
  status          String       @default("pendente")
  idempotencyKey  String?      @map("idempotency_key") @db.VarChar(128)
  idempotencyHash String?      @map("idempotency_hash") @db.Char(64)
  entrega         Json?        @map("entrega") @db.JsonB
  pagamento       String       @default("pix-simulado") @map("pagamento")
  created_at      DateTime     @default(now())
  usuario         Usuario      @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  itens           PedidoItem[]

  @@unique([usuario_id, idempotencyKey], map: "pedidos_usuario_id_idempotency_key")
  @@index([usuario_id, created_at])
  @@map("pedidos")
}

model PedidoItem {
  id             Int     @id @default(autoincrement())
  pedido_id      Int
  produto_id     Int
  quantidade     Int
  preco_unitario Decimal @db.Decimal(10, 2)
  nomeProduto    String? @map("nome_produto")
  pedido         Pedido  @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  produto        Produto @relation(fields: [produto_id], references: [id], onDelete: Restrict)

  @@index([produto_id])
  @@map("pedido_itens")
}

model SessaoRevogada {
  id         Int      @id @default(autoincrement())
  jti        String   @map("token") @db.Text
  revokedAt  DateTime @default(now()) @map("revoked_at")
  expiraEm   DateTime?

  @@index([jti])
  @@index([expiraEm])
  @@map("sessoes_revogadas")
}
